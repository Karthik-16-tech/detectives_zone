# Copy this file to backend/.env and fill in your Gemini API key.
# Get a key from https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Model used for multimodal photo-to-code solving.
# gemini-2.5-flash is the recommended fast multimodal model.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# Security / limits
MAX_IMAGE_SIZE_MB=8
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Code execution sandbox. KEEP DISABLED unless you understand the risks.
# Sandboxed sample execution only runs when explicitly enabled.
SANDBOX_ENABLED=false
# docker (recommended, isolates fully) | subprocess (interpreted langs only, host-level timeout/tmpfs)
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT_SECONDS=8
SANDBOX_MEMORY_MB=256
SANDBOX_CPU=0.5
