# Detective Zone Backend Configuration

# Database Connection (Supports PostgreSQL, MySQL, and SQLite)
# For MySQL:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/detective_zone
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/detective_zone
# For SQLite (default development fallback):
DATABASE_URL=sqlite:///./detective_zone.db

# JWT Security
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Server Settings
PROJECT_NAME="Detective Zone Backend API"
VERSION=1.0.0

# PhonePe Payment Gateway (Official API)
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
